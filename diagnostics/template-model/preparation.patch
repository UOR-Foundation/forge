diff --git a/site/worker.test.mjs b/site/worker.test.mjs
new file mode 100644
index 0000000..6472901
--- /dev/null
+++ b/site/worker.test.mjs
@@ -0,0 +1,60 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import test from "node:test";
+import vm from "node:vm";
+
+// Execute the complete production page, including main(), without extracting
+// or rewriting its functions. Runtime import attempts stand in for expensive
+// verification. The no-worker control proves this harness reaches that path.
+async function startPage(workers) {
+  const events = [];
+  const elements = new Map();
+  const element = (id) => {
+    if (id === "input") return null;
+    if (!elements.has(id)) elements.set(id, {
+      textContent: id === "app-data" ? "{}" : "",
+      addEventListener() {}, setAttribute() {},
+    });
+    return elements.get(id);
+  };
+  class Worker {
+    constructor() { events.push("worker-created"); }
+    postMessage() {}
+    terminate() {}
+  }
+  const context = vm.createContext({
+    TextEncoder, TextDecoder, URL, console,
+    document: { getElementById: element, documentElement: {}, baseURI: "https://example.test/app/" },
+    navigator: { onLine: true }, location: { hash: "", search: "" },
+    customElements: { get: () => true }, addEventListener() {},
+    performance: { getEntriesByName: () => [{}] },
+    requestAnimationFrame: (fn) => queueMicrotask(fn),
+    setTimeout: (fn) => { queueMicrotask(fn); return 1; },
+    ...(workers ? { Worker } : {}),
+  });
+  const source = await readFile(new URL("./app.mjs", import.meta.url), "utf8");
+  const page = new vm.SourceTextModule(source, {
+    context,
+    importModuleDynamically: async (specifier) => {
+      events.push(`main-import:${specifier}`);
+      throw new Error("test runtime load sentinel");
+    },
+  });
+  await page.link(() => { throw new Error("unexpected static import"); });
+  await page.evaluate();
+  // main() is asynchronous and deliberately not exported by the real page.
+  for (let i = 0; i < 10; i++) await new Promise(setImmediate);
+  return events;
+}
+
+test("FR-01 control: no-worker page still attempts the verified runtime", async () => {
+  const events = await startPage(false);
+  assert.ok(events.includes("main-import:./vendor/prism-code/src/browser.mjs"));
+});
+
+test("FR-01: working-worker startup never imports archive verification on the page", async () => {
+  const events = await startPage(true);
+  assert.deepEqual(events.filter((event) => event.startsWith("main-import:") && event.includes("prism-code/")), [],
+    "archive verification was imported on the UI thread before worker startup");
+  assert.ok(events.includes("worker-created"), "the production page must start its worker");
+});
