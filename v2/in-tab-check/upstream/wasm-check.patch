+/// A host with neither process groups nor a process tree starts no child
+/// (`verify` is refused there before one is spawned), so there is never a
+/// leader to end; being asked to end one is reported, never taken for success.
+#[cfg(not(any(unix, windows)))]
+pub(crate) fn end_leader(id: u32) -> GroupEnd {
+    GroupEnd::Failed(format!(
+        "process {id} cannot be ended: this host runs no child processes"
+    ))
+}
