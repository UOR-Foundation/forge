{
  // hologram-forge (ours, see VENDORED.md): the same files as tsconfig.hologram.json with Dyad's own ui, the
  // baseline hologram.typecheck.mjs compares the shell's build against.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.hologram.dyad.tsbuildinfo",
    "paths": {
      "*": ["./*"],
      // The kit's files sit outside this tree; their packages are the renderer's.
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "radix-ui": ["./node_modules/radix-ui"],
      "lucide-react": ["./node_modules/lucide-react"],
      "class-variance-authority": ["./node_modules/class-variance-authority"],
      "clsx": ["./node_modules/clsx"],
      "tailwind-merge": ["./node_modules/tailwind-merge"],
      "cmdk": ["./node_modules/cmdk"],
      "sonner": ["./node_modules/sonner"],
      "@/*": ["./src/*"],
      "pg-schema-classifier": ["./packages/pg-schema-classifier/src/index.ts"],
      "pg-schema-classifier/*": ["./packages/pg-schema-classifier/src/*"],
      "ts-pg-schema-diff": ["./packages/ts-pg-schema-diff/src/index.ts"],
      "ts-pg-schema-diff/*": ["./packages/ts-pg-schema-diff/src/*"]
    }
  },
  "include": ["src", "shared", "hologram.*.tsx", "hologram.env.d.ts", "packages/ts-pg-schema-diff/src", "packages/pg-schema-classifier/src"],
  "exclude": ["src/__tests__", "src/**/*.test.tsx", "src/**/*.test.ts", "src/**/*.stories.tsx", "src/components/ui/*.tsx"]
}
